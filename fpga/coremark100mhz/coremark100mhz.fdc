create_clock -name {ref_clk} [get_ports {clk27}] -period {37.037037} -waveform {0.000 18.5185185}
create_generated_clock -name {cpu_clk} -source [get_ports {clk27}] [get_nets {cpu_clk}] -master_clock [get_clocks {ref_clk}] -multiply_by {63} -divide_by {17}

define_attribute {p:led[7]} {PAP_IO_DIRECTION} {OUTPUT}
