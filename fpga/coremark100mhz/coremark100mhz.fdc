define_attribute {p:clk27} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:clk27} {PAP_IO_LOC} {D18}
define_attribute {p:clk27} {PAP_IO_VCCIO} {3.3}
define_attribute {p:clk27} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:clk27} {PAP_IO_NONE} {TRUE}


define_attribute {p:reset_n} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:reset_n} {PAP_IO_LOC} {C22}
define_attribute {p:reset_n} {PAP_IO_VCCIO} {3.3}
define_attribute {p:reset_n} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:reset_n} {PAP_IO_NONE} {TRUE}

# reset_n is asynchronous and feeds only the first synchronizer stage.
# Exempt that input path; reset_meta->reset_sync and all downstream CPU paths
# remain normally timed.
set_false_path -from [get_ports {reset_n}]

define_attribute {p:uart_tx} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:uart_tx} {PAP_IO_LOC} {C24}
define_attribute {p:uart_tx} {PAP_IO_VCCIO} {3.3}
define_attribute {p:uart_tx} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:uart_tx} {PAP_IO_DRIVE} {8}
define_attribute {p:uart_tx} {PAP_IO_SLEW} {SLOW}
set_output_delay -clock [get_clocks {cpu_clk}] -max 0.000 [get_ports {uart_tx}]
set_output_delay -clock [get_clocks {cpu_clk}] -max 0.000 [get_ports {led[*]}]
